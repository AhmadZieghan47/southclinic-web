# Development Tools
# Set to 'true' to show Development, UI Components, Charts & Maps, Tables, Icons, and Forms menu items
# Set to 'false' to hide these development sections (Main Menu and Admin sections are always visible)
VITE_DEV_TOOLS=true

# Auth bypass - Set to 'true' to disable all auth checks (dev only)
# When enabled: isAuthenticated() always returns true, getUser() returns mock admin, 401/403 errors are ignored
VITE_AUTH_DISABLED=false

# API Base URL
# Set to 'http://localhost:3000/api/v1' for local development
# Set to 'http://southphysicalcenter.org/api/v1' for production
VITE_API_BASE_URL=http://localhost:3000/api/v1